{
  "name": "virunthagam",
  "productName": "Virunthagam POS",
  "version": "v1.0.0",
  "description": "Desktop app that receives food order IDs over HTTP, fetches details from Supabase, and prints to thermal printers.",
  "author": "",
  "license": "MIT",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "npm run build:preload && tsc -p tsconfig.main.json -w & wait-on http://localhost:5173 dist/main/main/index.js dist/main/preload.js && cross-env NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && npm run build:preload",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --target=node18 --external:electron --outfile=dist/main/preload.js",
    "start": "cross-env NODE_ENV=production electron .",
    "package": "npm run build && electron-builder",
    "package:win32": "npm run build && electron-builder --win nsis:ia32 -c.nsis.artifactName=\"Virunthagam POS-${version}-ia32.${ext}\"",
    "release": "node scripts/release.js",
    "rebuild": "electron-rebuild -f -w @grandchef/node-printer",
    "postinstall": "electron-rebuild -f -w @grandchef/node-printer || echo \"electron-rebuild skipped (run 'npm run rebuild' manually if printing fails)\"",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@grandchef/node-printer": "^0.8.0",
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@supabase/supabase-js": "^2.108.2",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.11",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "node-thermal-printer": "^4.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "js-yaml": "^4.3.2",
    "prettier": "^3.8.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.octanovus.app",
    "productName": "Virunthagam POS",
    "artifactName": "${productName}-${version}.${ext}",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "asarUnpack": [
      "**/node_modules/@grandchef/node-printer/**"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/the-app-uses-UPDATE_BASE_URL"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Virunthagam POS",
      "uninstallDisplayName": "Virunthagam POS",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "allowScripts": {
    "@grandchef/node-printer@0.8.0": true
  }
}
