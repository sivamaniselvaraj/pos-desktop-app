# Copy to .env.local and fill in your Supabase project values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_TABLE=orders

# Local HTTP server the Android app posts order IDs to
HTTP_PORT=5000
HTTP_HOST=0.0.0.0

# Default printer (CUPS name on macOS/Linux, share name on Windows)
KITCHEN_PRINTER=
